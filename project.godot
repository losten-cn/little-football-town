; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Football Town"
config/description="像素足球小镇经营模拟 — 轻度足球经营 + 像素小镇养成 + 低压力长期成长"
config/version="0.1.0"
run/main_scene="res://src/ui/hud/Hud.tscn"
config/features=PackedStringArray("4.6")
config/run/main_scene=""

[autoload]

ConfigLoader="*res://src/autoload/config_loader.gd"
EventBus="*res://src/autoload/event_bus.gd"
TimeManager="*res://src/autoload/time_manager.gd"
SaveManager="*res://src/autoload/save_manager.gd"
ScreenManager="*res://src/autoload/screen_manager.gd"
AudioManager="*res://src/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="viewport"
window/size/window_min_size_override=Vector2i(1280, 720)

